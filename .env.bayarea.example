# Bay Area MeshCore Health Check — example .env
# Copy to .env, fill in the ==> TODO <== values, then: docker compose up -d --build
#
# WARNING: server.js parseEnvFileLoose() does NOT strip inline comments -- it
# takes everything after the first '=' as the value. Keep every comment on its
# own line. (An inline '# ...' after TEST_CHANNEL_HASH= made the hash literally
# "# ..." and broke channel matching.)

# ---------- App / branding ----------
PORT=3090
APP_TITLE=Bay Area Mesh Health Check
APP_EYEBROW=Bay Area MeshCore Observer Coverage
APP_HEADLINE=Check your mesh reach across the Bay Area.
# Keep the literal phrase "configured channel" in APP_DESCRIPTION: applyBranding()
# splits on it to place the channel chip. Without it the whole sentence becomes
# the hero prefix and the chip is stranded at the end of the line.
APP_DESCRIPTION=Send a test code and watch your mesh coverage build in real time from all over the Bay Area.
# ==> TODO: your public origin
SITE_URL=https://healthcheck.bayareameshcore.org
CORESCOPE_URL=https://corescope.stonekitty.net
EXTERNAL_LINK_URL=https://bayareameshcore.org/
EXTERNAL_LINK_LABEL=Bay Area MeshCore
LOG_LEVEL=info
TRUST_PROXY=1
DISTANCE_UNIT=mi

# ---------- Observer / result storage ----------
OBSERVERS_FILE=data/observer.json
RESULTS_FILE=data/session-results.json
OBSERVER_ACTIVITY_FILE=data/observer-activity.json

# ---------- Regions (Bay Area counties) ----------
REGIONS_FILE=regions/us-ca-bay-area.geojson
# Ignore advert/status positions that fall outside every region above.
# mqtt.gomesh.dev relays an Orlando FL cluster and a Philadelphia repeater;
# without this their coordinates stretch the coverage map across the country.
REQUIRE_REGION_MATCH=true
REGION_NAME_PROPERTY=name
REGION_GROUP_PROPERTY=group

# ---------- Coverage map scope ----------
# 'expected' (upstream default) plots only the 10-node scoring target, so the map
# reads "8 of 8 mapped" no matter how many observers actually heard the packet.
# 'directory' plots every observer that has coordinates, which matches the count
# on the "All regions" chip in the Observer Set panel.
MAP_OBSERVER_SCOPE=directory

# ---------- Uplink-code region fallback ----------
# Every MeshCore topic is meshcore/<CODE>/<pubkey>/<stream>, where <CODE> is the
# IATA-style identifier of the *uplink gateway's* metro - not the node's own
# position. About 40% of observers on mqtt.gomesh.dev never publish a position,
# so the code is the only region signal they emit.
#
# Two independent gates:
#   * UPLINK_CODES_FILE set -> codes listed in the file's "outOfArea" block are
#     excluded from the observer directory outright (counts, selection, map).
#     This is unconditional. Leave the file unset to keep upstream behaviour.
#   * REGION_FALLBACK=uplink-code -> additionally place coordinate-less
#     observers into the region *group* their code maps to. They get
#     regionGroup but never a county, so they are never drawn on the map and
#     are read-only: excluded from region selection and from the default target.
# Coordinates always win over the code when both are present.
UPLINK_CODES_FILE=regions/us-ca-uplink-codes.json
REGION_FALLBACK=uplink-code

# ---------- Basemap tiles ----------
# CARTO raster basemaps now require a free API key. Without one, every tile is
# stamped with an "API KEY REQUIRED" watermark; the map still works.
# Request a key (email, domain, one-line description - no account, no queue):
#   https://carto.com/basemaps/apikey/
# Free fair use: 5,000,000 tile requests per calendar month.
# CARTO + OpenStreetMap attribution must stay visible (the app already renders it).
# TODO: paste the key that CARTO emails back.
CARTO_API_KEY=
# Optional full overrides. Leave blank to use CARTO dark_all / light_all with the
# key above. With no key, light mode falls back to plain OpenStreetMap tiles.
MAP_TILE_DARK_URL=
MAP_TILE_LIGHT_URL=

# ---------- MQTT ----------
# GoMesh is the Bay Area broker. VERIFIED 2026-08-27 from the public internet:
#   * wss://mqtt.gomesh.dev:443  -> WebSocket upgrade OK (subprotocol "mqtt"),
#     anonymous CONNACK rc=0, but every SUBSCRIBE returned 0x80 (no read ACL).
#   * mqtt://mqtt.gomesh.dev:8883 and :1883 -> black-holed by Cloudflare
#     (proxied A record; Cloudflare does not proxy 1883/8883).
# So use WebSockets/443 and get subscriber credentials from the operator.
# This app authenticates with static username/password only — it cannot mint
# MeshCore device-signed JWTs.
MQTT_HOST=mqtt.gomesh.dev
MQTT_PORT=443
MQTT_TRANSPORT=websockets
MQTT_WS_PATH=/mqtt
MQTT_TLS=true
MQTT_USERNAME=example_user
# Set locally; do not commit.
MQTT_PASSWORD=
MQTT_CLIENT_ID=bayarea-health-check
# Equivalent single-line form, if you prefer:
# MQTT_URL=wss://mqtt.gomesh.dev:443/mqtt
MQTT_URL=
# NEVER leave MQTT_TOPIC unset: server.js falls back to meshcore/BOS/# (Boston).
# Confirm the live IATA codes once you have read access:
#   python3 scripts/probe-broker.py <user> <pass> 120
MQTT_TOPIC=meshcore/#
# Simpler if GoMesh grants broad read access:
# MQTT_TOPIC=meshcore/+/+/packets
DASH_BROKER_HOST=mqtt.gomesh.dev

# ---------- Test channel ----------
# Bay Area health-check channel: the hashtag channel #healthcheck
# NOTE: omit the leading '#' here -- server.js and app.js always render the
# name as `#${TEST_CHANNEL_NAME}` ("Send ABC123 to #healthcheck"). Writing
# "#healthcheck" would display as "##healthcheck".
CHANNELS_FILE=
TEST_CHANNEL_NAME=healthcheck
# Hashtag channel: the key IS the name. MeshCore derives it as
#   sha256("#healthcheck")[0:16] = 3ae59c2cda86744c75e68b3975a902ae
# The server cannot decrypt GroupText without it (server.js tryDecodeGroupText
# bails when decoderKeyCandidates is empty), so it must be set even though it
# is not a secret. Safe to commit -- anyone with the channel name has it.
TEST_CHANNEL_SECRET=3ae59c2cda86744c75e68b3975a902ae
# Leave blank: derived from the secret as sha256(key)[0] = 02.
TEST_CHANNEL_HASH=

# ---------- Session behavior ----------
SESSION_TTL_SECONDS=600
RESULT_RETENTION_SECONDS=604800
MAX_USES_PER_CODE=3
SESSION_RATE_WINDOW_SECONDS=600
SESSION_RATE_MAX=30

# ---------- Default observer target ----------
# Leave blank at launch so the app auto-picks the most active Bay Area observers.
# Later, pin a curated set of full public keys (hilltop/rooftop observers).
KNOWN_OBSERVERS=
# active     = score against every eligible observer that reported inside
#              OBSERVER_ACTIVE_WINDOW_SECONDS. Right for the Bay Area, where the
#              eligible pool is roughly twice OBSERVER_TOP_COUNT, so a fixed
#              top-10 slice both understates the audience and flips membership
#              on packet-count ties.
# top-window = upstream behaviour, the busiest OBSERVER_TOP_COUNT observers over
#              OBSERVER_TOP_WINDOW_DAYS.
OBSERVER_TARGET_MODE=active
OBSERVER_TOP_WINDOW_DAYS=7
# Still used for the ranking shown in the observer picker, and as the scoring
# target when OBSERVER_TARGET_MODE=top-window.
OBSERVER_TOP_COUNT=10
# Smallest scoring set that earns a graded percentage. A single-observer target
# is a reachability check, not a health measurement: heard or not heard. Below
# this, the dashboard still shows the raw "n / n" count but withholds the
# percentage and the grade rather than reporting "1 / 1, 100% VERY HEALTHY".
# Set to 1 to restore upstream behaviour and always grade.
OBSERVER_MIN_SCORING_SET=3

# Fallback prefix width only. Each observer now shows its own path hash width
# when CoreScope confirmed it from that node's own advert (seed-observers.py
# writes it as "hashBytes" into data/observer.json). This value is used for
# observers with no confirmed width. Keep it at 1 - inflating it here would
# print bytes the node does not actually transmit.
OBSERVER_HASH_DISPLAY_BYTES=1
OBSERVER_ACTIVE_WINDOW_SECONDS=900
OBSERVER_RETENTION_SECONDS=0

# ---------- Turnstile (internet-facing) ----------
TURNSTILE_ENABLED=true
# ==> TODO
TURNSTILE_SITE_KEY=
# ==> TODO
TURNSTILE_SECRET_KEY=
TURNSTILE_API_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
TURNSTILE_COOKIE_NAME=mesh_health_turnstile
TURNSTILE_TOKEN_TTL_SECONDS=86400
TURNSTILE_BOT_BYPASS=true
TURNSTILE_BOT_ALLOWLIST=discordbot,twitterbot,slackbot,facebookexternalhit,linkedinbot,telegrambot,whatsapp
TURNSTILE_VERIFY_RATE_WINDOW_SECONDS=600
TURNSTILE_VERIFY_RATE_MAX=10
