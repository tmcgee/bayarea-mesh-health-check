{
  "name": "mesh-health-check",
  "version": "1.3.8+bayarea.5",
  "private": true,
  "type": "module",
  "description": "MeshCore observer health checker for #health-check message propagation",
  "main": "server.js",
  "scripts": {
    "check": "node --check server.js && node --check public/app.js && node --check public/turnstile-landing.js",
    "test": "MESH_HEALTH_SKIP_ENV_FILE=true node --test test/*.test.js",
    "test:ci": "MESH_HEALTH_SKIP_ENV_FILE=true node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=junit.xml test/*.test.js",
    "test:smoke": "playwright test",
    "docker:tag": "node scripts/docker-tag.js",
    "postinstall": "node scripts/patch-meshcore-decoder.js",
    "start": "node server.js",
    "dev": "node --watch server.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "dependencies": {
    "@michaelhart/meshcore-decoder": "^0.3.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "mqtt": "^5.15.2",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=18"
  }
}
